# Pinned inputs. Change one at a time and rebuild + recheck when you do.

# Nothing Phone (3a) "Asteroids", VoltageOS kernel 6.6.144-android15-8-4k-g580b8ea6c4fb.
# Source found in PixelOS's tree (VoltageOS has not pushed this commit).
KERNEL_REPO=https://github.com/pixelos-asteroids/android_kernel_nothing_sm7635.git
KERNEL_SHA=580b8ea6c4fbcd96425476f5f63c17cac6b824e4

# The ROM's compiler. Any other clang changes the CRCs of icc_* symbols and the
# vendor_boot modules (arm_smmu, clk-qcom, qcom-scm...) refuse to load.
CLANG_VERSION=r596125

FINASU_REPO=LyraVoid/FinaSU

# Baseband Guard (vc-teahouse/Baseband-guard), main as of 2026-07-26.
BBG_REPO=https://github.com/vc-teahouse/Baseband-guard.git
BBG_COMMIT=a54e0dc6cf0aff4dd87fec49644a02d2eb612905

# Unicode fix and BBRv3 patches (WildKernels/kernel_patches), main as of 2026-10-24.
KERNEL_PATCHES_REPO=https://github.com/WildKernels/kernel_patches.git
KERNEL_PATCHES_COMMIT=159a8f3b93af582b07d0d44bfa7d08b96d667ec0

# The SUSFS commit is not pinned here: it is read from the selected FinaSU
# release (EXPECTED_COMMIT in scripts/check-susfs-upstream.sh).
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=gki-android15-6.6
